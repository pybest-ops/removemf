{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "matcha-filter-remover",
  "main": ".open-next/worker.js",
  "workers_dev": true,
  "preview_urls": true,
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://removematchafilter.org",
    "AUTH_TRUST_HOST": "true"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "matcha-filter-remover",
      "database_id": "444c33d7-0154-4a73-8118-54c4bc02691d",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    {
      "pattern": "removematchafilter.org",
      "custom_domain": true
    },
    {
      "pattern": "www.removematchafilter.org",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
